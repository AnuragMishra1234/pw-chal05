# Celebration & Event Planner — Backend Environment Configuration
PORT=8000
NODE_ENV=development
# Set MONGODB_URI to connect to MongoDB Atlas or local MongoDB instance (e.g. mongodb://localhost:27017/celebration)
# If omitted or unavailable, the backend gracefully runs with an in-memory repository store in development mode.
MONGODB_URI=
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=dev-session-secret-celebration-key-12345

# GenAI Planning Engine Provider Configuration
# Supported options: "gemini" | "groq" | "mock" (default: "mock" for zero-cost deterministic dev/tests)
LLM_PROVIDER=mock
# LLM Model (e.g. "gemini-1.5-flash", "gemini-1.5-pro", "llama-3.3-70b-versatile")
LLM_MODEL=
# Provider API Keys (Server-side only — never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Request timeout in milliseconds (default: 25000)
LLM_TIMEOUT_MS=25000

