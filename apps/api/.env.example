# Celebration & Event Planner — Backend Environment Configuration
PORT=8000
NODE_ENV=development

# MongoDB Connection String:
# - In Development/Test: Leave blank for in-memory fallback store.
# - In Production: REQUIRED. Must be a valid MongoDB Atlas connection string:
#   mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/celebration?retryWrites=true&w=majority
MONGODB_URI=

# Frontend Origin for CORS enforcement:
# - In Development: http://localhost:3000
# - In Production: https://<your-vercel-domain>.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Session Secret (must be a strong random 32+ character key in production)
SESSION_SECRET=dev-session-secret-celebration-key-12345

# GenAI Planning Engine Provider Configuration:
# - Options: "gemini" | "groq" | "mock"
# - In production, "gemini" or "groq" is recommended. "mock" requires ALLOW_MOCK_IN_PRODUCTION=true.
LLM_PROVIDER=mock
ALLOW_MOCK_IN_PRODUCTION=false

# LLM Model (optional override):
# - Gemini: "gemini-1.5-flash", "gemini-1.5-pro"
# - Groq: "llama-3.3-70b-versatile", "mixtral-8x7b-32768"
LLM_MODEL=

# Provider API Keys (Server-side ONLY — NEVER expose to client/browser)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Request timeout in milliseconds (default: 25000)
LLM_TIMEOUT_MS=25000
