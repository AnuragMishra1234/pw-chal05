# ==============================================================================
# Celebration & Event Planner — Environment Configuration Template
# Copy this file to .env (for local backend) or .env.local (for local frontend).
# NEVER commit real credentials, production secrets, or private keys to source control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=8000

# Persistence (MongoDB Atlas or Local Instance)
# Leave blank or unconfigured to automatically use the in-memory persistence fallback for zero-config local dev/test
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/celebration_planner?retryWrites=true&w=majority
MONGODB_URI=

# Generative AI Provider Configuration
# Supported providers: "gemini" | "groq" | "mock" (default: "mock" for zero-cost deterministic dev/tests)
LLM_PROVIDER=mock

# Model selection (optional, e.g. "gemini-1.5-flash", "llama-3.3-70b-versatile")
LLM_MODEL=mock-model

# Google Gemini API Key (Server-side secret only - NEVER use NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Alternative provider - Server-side secret only)
GROQ_API_KEY=your_groq_api_key_here

# Request timeout in milliseconds (default: 25000)
LLM_TIMEOUT_MS=25000

# Security & Session Secrets
# Secret key used to sign session cookies or JWT tokens
SESSION_SECRET=replace_with_a_long_random_secure_secret_string

# Cross-Origin Resource Sharing (CORS)
# The origin permitted to call backend API endpoints in production
FRONTEND_ORIGIN=http://localhost:3000

# Client-Side Configuration (Next.js Public Variables)
# The base URL the Next.js frontend uses to communicate with the Express API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
