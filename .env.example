# =============================================================================
# Celebration & Event Planner — Master Environment Template
# =============================================================================
# Universal GenAI-Powered Event Planning & Lifecycle Management Platform
# Copy this file to .env (or configure in Render / Vercel dashboard) before starting.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. API Server Configuration (apps/api)
# -----------------------------------------------------------------------------
PORT=8000
NODE_ENV=development

# MongoDB Connection String:
# - In Development/Test: Leave blank for automatic in-memory fallback store.
# - In Production: REQUIRED. Must be a valid MongoDB Atlas connection string:
#   mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/celebration?retryWrites=true&w=majority
MONGODB_URI=

# CORS Allowed Origin for Frontend Client:
# - In Development: http://localhost:3000
# - In Production: https://<your-vercel-domain>.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Session Secret (must be a random 32+ character key in production)
SESSION_SECRET=dev-session-secret-celebration-key-12345

# -----------------------------------------------------------------------------
# 2. GenAI Planning Engine Configuration (Server-Side Only)
# -----------------------------------------------------------------------------
# Supported options: "gemini" | "groq" | "mock"
# Default is "mock" for zero-cost, deterministic local development and automated testing.
# In Production, "gemini" or "groq" must be used with a valid API key.
LLM_PROVIDER=mock
ALLOW_MOCK_IN_PRODUCTION=false

# LLM Model (optional override):
# - Gemini: "gemini-1.5-flash", "gemini-1.5-pro"
# - Groq: "llama-3.3-70b-versatile", "mixtral-8x7b-32768"
LLM_MODEL=

# Provider API Keys (Server-side ONLY — NEVER expose with NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Request timeout in milliseconds (default: 25000)
LLM_TIMEOUT_MS=25000

# -----------------------------------------------------------------------------
# 3. Frontend Client Configuration (apps/web)
# -----------------------------------------------------------------------------
# Base URL for API client requests from browser:
# - In Development: http://localhost:8000/api/v1
# - In Production: https://<your-render-service>.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
